@model AutomovilVista
@{ViewData["Title"]="Detalles del automóvil";}
<a class="back-link" asp-action="Index">← Volver a automóviles</a><div class="page-heading"><div><p class="eyebrow">FICHA DEL VEHÍCULO</p><h1>@Model.Fabricante <span class="heading-id">#@Model.Id</span></h1><p class="subtitle">Datos del automóvil y sus registros de ingreso.</p></div><partial name="_Fuente" model="(string)ViewBag.Fuente" /></div><section class="card detail-card"><dl class="details-grid"><div><dt>Identificador</dt><dd>#@Model.Id</dd></div><div><dt>Fabricante</dt><dd>@Model.Fabricante</dd></div><div><dt>Año</dt><dd>@Model.Anio</dd></div><div><dt>Color</dt><dd>@Model.Color</dd></div><div><dt>Tipo</dt><dd>@Model.Tipo</dd></div><div><dt>Ingresos registrados</dt><dd>@Model.Ingresos.Count</dd></div></dl><div class="form-actions"><a class="button secondary" asp-action="Index">Volver</a><a class="button primary" asp-action="Editar" asp-route-id="@Model.Id">Editar automóvil</a></div></section>
<div class="results-heading"><h2>Ingresos relacionados</h2></div><section class="card table-card">@if(Model.Ingresos.Count==0){<div class="empty"><h3>Este automóvil todavía no registra ingresos.</h3></div>}else{<div class="table-scroll"><table><thead><tr><th>Ingreso</th><th>Parqueo</th><th>Entrada</th><th>Salida</th></tr></thead><tbody>@foreach(var i in Model.Ingresos){<tr><td>#@i.Consecutivo</td><td>#@i.IdParqueo</td><td>@i.Entrada.ToString("dd/MM/yyyy HH:mm")</td><td>@(i.Salida?.ToString("dd/MM/yyyy HH:mm")??"En el parqueo")</td></tr>}</tbody></table></div>}</section>
