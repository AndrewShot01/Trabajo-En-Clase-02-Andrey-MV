@model AutomovilFormulario
@{ViewData["Title"]="Editar automóvil";ViewData["Edicion"]=true;}
<a class="back-link" asp-action="Index">← Volver a automóviles</a><div class="page-heading"><div><p class="eyebrow">MANTENIMIENTO</p><h1>Editar automóvil <span class="heading-id">#@Model.Id</span></h1><p class="subtitle">Actualiza los datos del vehículo y guarda los cambios.</p></div><partial name="_Fuente" model="(string)ViewBag.Fuente" /></div><section class="card form-card"><form method="post" asp-action="Editar" asp-route-id="@Model.Id"><partial name="_Formulario" model="Model" /><div class="form-actions"><a class="button secondary" asp-action="Index">Cancelar</a><button class="button primary" type="submit">Guardar cambios</button></div></form></section>
