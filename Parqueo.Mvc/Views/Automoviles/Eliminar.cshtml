@model AutomovilVista
@{ViewData["Title"]="Eliminar automóvil";}
<a class="back-link" asp-action="Index">← Volver a automóviles</a><div class="page-heading"><div><p class="eyebrow">MANTENIMIENTO</p><h1>Eliminar automóvil</h1><p class="subtitle">Revisa el vehículo antes de confirmar la eliminación.</p></div><partial name="_Fuente" model="(string)ViewBag.Fuente" /></div><section class="card form-card"><div asp-validation-summary="All" class="validation" role="alert"></div><h2>@Model.Fabricante <span class="muted">#@Model.Id</span></h2><p>@Model.Color · @Model.Anio · @Model.Tipo</p>@if(Model.Ingresos.Count>0){<div class="notice warning">Este vehículo tiene @Model.Ingresos.Count ingreso(s) relacionado(s). No se puede eliminar mientras conserve ese historial.</div><div class="form-actions"><a class="button secondary" asp-action="Index">Volver a la lista</a><a class="button primary" asp-action="Detalles" asp-route-id="@Model.Id">Ver detalles</a></div>}else{<p>Esta acción eliminará el vehículo de la fuente indicada.</p><form method="post" asp-action="Eliminar" asp-route-id="@Model.Id"><div class="form-actions"><a class="button secondary" asp-action="Index">Cancelar</a><button class="button danger" type="submit">Confirmar eliminación</button></div></form>}</section>
