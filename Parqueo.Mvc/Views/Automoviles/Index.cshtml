@model ListadoAutomoviles
@{ViewData["Title"]="Automóviles";}
<div class="page-heading"><div><p class="eyebrow">FLOTA VEHICULAR</p><h1>Automóviles</h1><p class="subtitle">Consulta y administra los vehículos registrados en el parqueo.</p></div><a class="button primary" asp-action="Crear"><span aria-hidden="true">＋</span> Nuevo automóvil</a></div>
<section class="card filters" aria-label="Filtrar por año"><div class="section-top"><h2>Buscar por año</h2><partial name="_Fuente" model="Model.Fuente" /></div><form method="get" asp-action="Index" class="filter-form"><div class="field"><label asp-for="Desde"></label><input asp-for="Desde" type="number" min="1886" max="2100" required /><span asp-validation-for="Desde"></span></div><div class="field"><label asp-for="Hasta"></label><input asp-for="Hasta" type="number" min="1886" max="2100" required /><span asp-validation-for="Hasta"></span></div><button class="button primary" type="submit">Consultar vehículos <span aria-hidden="true">→</span></button><a class="text-link" asp-action="Index">Ver todos</a></form><div asp-validation-summary="All" class="validation" role="alert"></div></section>
<div class="results-heading"><h2>Vehículos registrados <span class="count">@Model.Automoviles.Count</span></h2><span>Intervalo inclusivo de años</span></div><section class="card table-card" aria-label="Resultados de vehículos">
@if(Model.Automoviles.Count==0){<div class="empty"><span class="empty-icon" aria-hidden="true">P</span><h3>@(ViewData.ModelState.IsValid?"No hay vehículos en este intervalo":"No se pudieron cargar los vehículos")</h3><p>@(ViewData.ModelState.IsValid?"Prueba con otros años o registra un nuevo automóvil.":"Revisa los datos del filtro y que la API esté iniciada.")</p></div>}
else{<div class="table-scroll"><table><thead><tr><th>ID</th><th>Fabricante</th><th>Color</th><th>Año</th><th>Tipo</th><th class="right">Mantenimiento</th></tr></thead><tbody>@foreach(var a in Model.Automoviles){<tr data-vehicle-id="@a.Id"><td class="muted mono">#@a.Id</td><td class="strong">@a.Fabricante</td><td><span class="color-dot"></span>@a.Color</td><td>@a.Anio</td><td><span class="pill">@a.Tipo</span></td><td class="actions"><a asp-action="Detalles" asp-route-id="@a.Id" aria-label="Ver detalles del automóvil @a.Id">Detalles</a><a asp-action="Editar" asp-route-id="@a.Id" aria-label="Editar automóvil @a.Id">Editar</a><a class="danger-link" asp-action="Eliminar" asp-route-id="@a.Id" aria-label="Eliminar automóvil @a.Id">Eliminar</a></td></tr>}</tbody></table></div>}
</section><p class="footnote">Los cambios se guardan en la fuente indicada. Un automóvil con ingresos relacionados no se puede eliminar.</p>
