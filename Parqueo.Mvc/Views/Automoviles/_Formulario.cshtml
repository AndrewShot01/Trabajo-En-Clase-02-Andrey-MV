@model AutomovilFormulario
@{var edicion=ViewData["Edicion"] is true;}
<div asp-validation-summary="All" class="validation" role="alert"></div><div class="form-grid"><div class="field"><label asp-for="Id">Identificador</label>@if(edicion){<input asp-for="Id" type="hidden" /><input value="@Model.Id" aria-label="Identificador" disabled /><small>El identificador no se modifica.</small>}else{<input asp-for="Id" type="number" min="1" max="2147483647" required /><small>Debe ser único en la fuente seleccionada.</small>}<span asp-validation-for="Id"></span></div><div class="field"><label asp-for="Anio"></label><input asp-for="Anio" type="number" min="1886" max="2100" required /><span asp-validation-for="Anio"></span></div><div class="field"><label asp-for="Fabricante"></label><input asp-for="Fabricante" maxlength="80" required placeholder="Ej. Toyota" /><span asp-validation-for="Fabricante"></span></div><div class="field"><label asp-for="Color"></label><input asp-for="Color" maxlength="50" required placeholder="Ej. Blanco" /><span asp-validation-for="Color"></span></div><div class="field span-two"><label asp-for="Tipo"></label><select asp-for="Tipo"><option value="sedán">Sedán</option><option value="4x4">4x4</option><option value="moto">Moto</option></select><span asp-validation-for="Tipo"></span></div></div>
