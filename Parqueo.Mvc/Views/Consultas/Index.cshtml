@model MaestroDetalle
@{ViewData["Title"]="Estadías por tipo";}
<div class="page-heading"><div><p class="eyebrow">CONSULTA MAESTRO / DETALLE</p><h1>Estadías por tipo</h1><p class="subtitle">Elige un tipo de vehículo y selecciona un automóvil para ver su historial.</p></div><partial name="_Fuente" model="Model.Fuente" /></div>
<section class="card filters"><form method="get" asp-action="Index" class="filter-form"><div class="field type-field"><label for="tipo">Tipo de automóvil</label><select id="tipo" name="tipo">@foreach(var tipo in Parqueo.Mvc.Controllers.ConsultasController.Tipos){<option value="@tipo" selected="@(tipo==Model.Tipo)">@(tipo=="sedán"?"Sedán":tipo=="moto"?"Moto":"4x4")</option>}</select></div><button class="button primary" type="submit">Consultar vehículos <span aria-hidden="true">→</span></button></form><div asp-validation-summary="All" class="validation" role="alert"></div></section>
<div class="results-heading"><h2>Selecciona un automóvil <span class="count">@Model.Automoviles.Count</span></h2><span>Tipo: @Model.Tipo</span></div><section class="card table-card">@if(Model.Automoviles.Count==0){<div class="empty"><h3>@(ViewData.ModelState.IsValid?"No hay automóviles de este tipo":"No se pudieron consultar los automóviles")</h3><p>Selecciona otro tipo o revisa el mensaje de la consulta.</p></div>}else{<div class="table-scroll"><table><thead><tr><th>ID</th><th>Fabricante</th><th>Año</th><th>Color</th><th class="right">Historial</th></tr></thead><tbody>@foreach(var a in Model.Automoviles){<tr data-master-id="@a.Id"><td class="muted mono">#@a.Id</td><td class="strong">@a.Fabricante</td><td>@a.Anio</td><td><span class="color-dot"></span>@a.Color</td><td class="right"><button class="button secondary small select-vehicle" type="button" data-id="@a.Id" data-name="@a.Fabricante" data-url="@Url.Action("Ingresos","Consultas",new{id=a.Id})" aria-controls="panel-estadias" aria-expanded="false">Ver estadías <span aria-hidden="true">↓</span></button></td></tr>}</tbody></table></div>}</section>
<section id="panel-estadias" class="card stays-panel" aria-labelledby="titulo-estadias" aria-busy="false"><div class="section-top"><div><p class="eyebrow">DETALLE DEL AUTOMÓVIL</p><h2 id="titulo-estadias">Historial de estadías</h2></div><span id="contador-estadias" class="count" hidden></span></div><p id="estado-estadias" class="subtitle" role="status" aria-live="polite">Selecciona un automóvil de la lista para consultar sus ingresos.</p><div id="tabla-estadias" class="table-scroll" hidden><table><thead><tr><th>Parqueo</th><th>Entrada</th><th>Salida</th><th class="right">Minutos</th><th class="right">Horas</th><th class="right">Monto a cancelar</th></tr></thead><tbody id="filas-estadias"></tbody></table></div></section>
@section Scripts{<script src="~/js/maestro-detalle.js" asp-append-version="true" defer></script>}
