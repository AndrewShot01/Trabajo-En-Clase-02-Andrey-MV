<!DOCTYPE html><html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>@ViewData["Title"] · Parqueo</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head><body>
<header class="topbar"><div class="nav-wrap"><a class="brand" asp-controller="Automoviles" asp-action="Index"><span class="brand-mark">P<span>·</span></span><span>Parqueo<small>CONTROL VEHICULAR</small></span></a><nav aria-label="Navegación principal"><a class="@(ViewContext.RouteData.Values["controller"]?.ToString()=="Automoviles"?"active":"")" asp-controller="Automoviles" asp-action="Index">Automóviles</a><a class="@(ViewContext.RouteData.Values["controller"]?.ToString()=="Consultas"?"active":"")" asp-controller="Consultas" asp-action="Index">Estadías por tipo</a></nav><span class="local-tag"><i></i> Entorno local</span></div></header>
<main id="contenido" class="container">@if(TempData["Exito"] is string exito){<div class="notice success" role="status">@exito</div>}@RenderBody()</main><footer class="footer"><span>Parqueo · Administración de vehículos y estadías</span><span>Programación Avanzada / Trabajo 04</span></footer>@await RenderSectionAsync("Scripts",required:false)</body></html>
